# Copy to .env and fill in. The compose file will refuse to start until
# SECRET_KEY_BASE, DATABASE_PASSWORD, and POSTGRES_PASSWORD are set.

# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=

# Postgres credentials. Keep POSTGRES_PASSWORD and DATABASE_PASSWORD identical.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=dawarich_production
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_NAME=dawarich_production

# Host port the Dawarich UI is reachable on (http://localhost:${DAWARICH_APP_PORT}).
DAWARICH_APP_PORT=3000

# Comma-separated hosts allowed to reach the app. Add your LAN IP if you want
# to hit the UI from your phone.
APPLICATION_HOSTS=localhost,127.0.0.1,::1

# Your local timezone (used for stats bucketing). e.g. America/Los_Angeles
TIME_ZONE=Etc/UTC

# Sidekiq concurrency. Bump if imports are slow on a beefy machine.
BACKGROUND_PROCESSING_CONCURRENCY=5
